{
    "name": "aldaris",
    "private": true,
    "license": "AGPL-3.0-only",
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "migrate": "wrangler d1 migrations apply DB --local",
        "migrate:remote": "wrangler d1 migrations apply DB --remote",
        "check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
        "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build",
        "preview": "vite preview",
        "deploy": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build && wrangler deploy"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@mui/material": "9.4.0",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.54.4",
        "@cloudflare/workers-types": "5.20260904.1",
        "@types/node": "26.4.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "@vitejs/plugin-react": "6.1.1",
        "typescript": "6.0.3",
        "vite": "8.2.2",
        "wrangler": "4.129.0"
    }
}
