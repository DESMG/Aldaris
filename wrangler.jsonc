{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "aldaris",
    "main": "worker/index.ts",
    "compatibility_date": "2026-07-30",
    "send_metrics": false,
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*"
        ]
    }
}
