{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "aldaris",
    "main": "worker/index.ts",
    "compatibility_date": "2026-07-30",
    "compatibility_flags": ["nodejs_compat"],
    "keep_vars": true,
    "send_metrics": false,
    "triggers": { "crons": ["*/15 * * * *"] },
    "kv_namespaces": [
        { "binding": "KV" }
    ],
    "d1_databases": [
        { "binding": "DB", "database_name": "aldaris" }
    ],
    "r2_buckets": [
        { "binding": "IMAGES", "bucket_name": "aldaris-images" }
    ],
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*"
        ]
    }
}
