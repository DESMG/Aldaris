{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "aldaris",
    "main": "worker/index.ts",
    "compatibility_date": "2026-07-30",
    "compatibility_flags": ["nodejs_compat"],
    "keep_vars": true,
    "send_metrics": false,
    "exports": {
        "default": { "type": "worker", "cache": { "enabled": false } },
        "Images": { "type": "worker", "cache": { "enabled": true } }
    },
    "triggers": { "crons": ["0 * * * *"] },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "aldaris",
            "preview_database_id": "DB"
        }
    ],
    "r2_buckets": [
        { "binding": "IMAGES", "bucket_name": "aldaris-images" }
    ],
    "assets": {
        "not_found_handling": "404-page",
        "run_worker_first": [
            "/api/*"
        ]
    }
}
